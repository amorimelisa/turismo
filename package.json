{
  "name": "vooa-elisa",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node scripts/start-all.js",
    "start:app": "expo start",
    "start:api": "npm --prefix server start",
